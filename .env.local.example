# Neonプロジェクト作成後、Neon Console から接続文字列を取得し、
# このファイルを .env.local としてコピーしてプレースホルダーを実際の値に置き換えてください。
# .env.local はコミットしないでください（.gitignore で除外済み）。
#
# 重要: DATABASE_URLにNEXT_PUBLIC_を付けないこと。
# ブラウザへ公開してはいけない接続情報のため、Server Component / server-sideからのみ参照する。

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
